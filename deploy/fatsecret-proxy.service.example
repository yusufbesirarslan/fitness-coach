# FatSecret loopback proxy — systemd unit ŞABLONU (I4).
#
# Bu repo, EC2 host'unda 127.0.0.1:3000'i dinleyen FatSecret proxy sürecinin
# kodunu İÇERMEZ; nginx yalnızca /fatsecret/rest/server.api isteklerini ona
# yönlendirir (nginx.conf). Süreç bugüne dek elle başlatılıyordu: çökerse
# kimse yeniden başlatmaz, tüm besin aramaları 502 olur ve makro çözümü
# sessizce LLM tahminine düşer.
#
# Kurulum (EC2 host'unda, bir kez):
#   1. ExecStart/WorkingDirectory/User satırlarını gerçek proxy komutuna göre doldur.
#   2. sudo cp deploy/fatsecret-proxy.service.example /etc/systemd/system/fatsecret-proxy.service
#   3. sudo systemctl daemon-reload && sudo systemctl enable --now fatsecret-proxy
#   4. Doğrula: ss -ltn | grep 127.0.0.1:3000  (deploy.yml her deploy'da kontrol eder,
#      /health?deep=1 "fatsecret_proxy" alanında raporlar)

[Unit]
Description=FatSecret loopback proxy (Bearer token loopback disina cikmasin)
After=network.target

[Service]
# ÖRNEK — gerçek proxy komutuyla değiştirin:
# ExecStart=/usr/bin/node /opt/fatsecret-proxy/server.js
# WorkingDirectory=/opt/fatsecret-proxy
# EnvironmentFile=/opt/fatsecret-proxy/.env
ExecStart=/CHANGE/ME
Restart=always
RestartSec=5
# Yalnızca loopback dinlemeli; kimlik düşür.
User=nobody
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
