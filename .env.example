# FitX ortam değişkenleri örneği.
# Kopyala:  cp .env.example .env   ve değerleri doldur. .env'i COMMIT ETME.
#
# ── SIRLARIN SAKLANMASI (M4 — kabul edilen durum) ────────────────────────────
# Prod'da bu dosya EC2 host'unda DÜZ METİN durur ve compose `env_file` ile
# konteynere yükler → değerler `docker inspect` ve /proc/<pid>/environ ile
# görülebilir. Deploy her çalıştığında dosyayı `chmod 600` yapar.
# İzinleri elle de doğrula:  chmod 600 .env
#
# Bu, projenin geri kalanıyla TUTARSIZDIR: S3 ve Bedrock kimlik bilgileri zaten
# EC2 IAM Instance Profile'dan gelir (hiçbir uzun ömürlü anahtar saklanmaz).
# Sıradaki adım: bu değerleri SSM Parameter Store'a (SecureString) taşıyıp boot'ta
# instance profile ile çekmek (ssm:GetParameters + kms:Decrypt izni gerekir).
#
# ROTASYON TUZAĞI: SECRET_KEY veya COGNITO_TOKEN_ENC_KEY döndürülürse TÜM AKTİF
# OTURUMLAR GEÇERSİZ OLUR (biri oturum çerezlerini imzalar, diğeri DB'deki Cognito
# token'larını çözer). Yani bir sızıntıdan sonra rotasyon güdüsü tam TERS yönde
# çalışır. Rotasyonu düşük trafikli bir pencerede planla ve herkesin çıkış
# yapacağını hesaba kat.

# ── Flask ──
# Uzun, rastgele bir değer üret:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
# Yalnızca yerel geliştirme için (prod'da KAPALI bırak):
# FLASK_DEBUG=1
# FLASK_ENV=development

# ── Çalışma zamanı / loglama / Gunicorn ──
# LOG_LEVEL=INFO
# FITX_WEB_WORKERS=1
# FITX_WEB_THREADS=8
# UYARI: Birden fazla web worker kullanmak Redis gerektirir ve süreç başına AI eşzamanlılık bütçelerini worker sayısıyla çarpar.

# ── Veritabanı (AWS RDS PostgreSQL) ──
# Prod artık RDS kullanır; compose'taki bundled Postgres ("db") servisi KALDIRILDI.
# DATABASE_URL ZORUNLU — yoksa uygulama sessizce SQLite'a düşer (app/config.py:112).
DATABASE_URL=postgresql://USER:PASSWORD@your-instance.xxxx.eu-central-1.rds.amazonaws.com:5432/DBNAME
# Lokal geliştirme için DATABASE_URL'i hiç vermezsen varsayılan sqlite:///chatbot.db
# kullanılır; ya da kendi yerel Postgres'inin URL'sini gir.
#
# Havuz boyutu AÇIKÇA ayarlanır (Hardening PR4). Varsayılanlar thread sayısından
# türetilir ve boot invariant'ı `DB_POOL_SIZE + DB_POOL_MAX_OVERFLOW >=
# FITX_WEB_THREADS` şartını DOĞRULAR — havuz thread'leri karşılamazsa kapıların
# koruduğu /health rezervi havuz tarafından delinirdi. docs/CAPACITY.md
# DB_POOL_SIZE=8                 # varsayılan: FITX_WEB_THREADS
# DB_POOL_MAX_OVERFLOW=4
# DB_POOL_TIMEOUT_SECONDS=10     # eski örtük SQLAlchemy varsayılanı 30 idi
# DB_POOL_RECYCLE_SECONDS=280

# ── FatSecret proxy ──
FATSECRET_CLIENT_ID=
FATSECRET_CLIENT_SECRET=
# Prod'da https zorunlu (OAuth token Authorization başlığında gider).
# nginx /fatsecret/ konumu bunu statik IP'deki proxy'ye yönlendirir.
FATSECRET_BASE_URL=https://your-domain.example.com/fatsecret

# ── OpenAI ──
# Anahtarı https://platform.openai.com/api-keys adresinden al. .env'i COMMIT ETME.
# Anahtar bir yerde düz metin paylaşıldıysa hemen rotate et.
OPENAI_API_KEY=sk-...
# Varsayılan model (override etmek istemezsen boş bırakabilirsin):
OPENAI_MODEL=gpt-4o-mini

# ── Bedrock (Claude Sonnet 4.5 — ağır görevler) ──
# Kimlik bilgisi EC2 IAM Instance Profile'dan OTOMATİK gelir (S3 ile aynı); .env'de
# veya kodda HİÇBİR anahtar TUTULMAZ. İnstance role'üne bedrock:InvokeModel izni gerekir.
# Açmak için (yalnızca izin + model erişimi hazır olan ortamda, örn. prod):
BEDROCK_ENABLED=1
# Bölge ve model varsayılanları (gerekmedikçe değiştirme):
# BEDROCK_REGION=eu-central-1
# BEDROCK_MODEL=global.anthropic.claude-sonnet-4-5-20250929-v1:0
# BEDROCK_MAX_TOKENS=8000
# AI_COACH_TURN_TIMEOUT_SECONDS=90
# Sonnet pahalı olduğundan ağır üretken route'lara (plan/menü/koç/check-in) binen
# daha sıkı, kullanıcı-başı ikinci rate limit tavanı:
# BEDROCK_RATELIMIT=10 per hour

# Sprint 6 PR4 — canonical deterministic AdaptivePlan context for AI Coach.
# Strict opt-in rollout gate: 0 preserves the pre-PR4 context/prompt path exactly;
# 1 adds the versioned read-only contract. Turning back to 0 is the full rollback.
# AI_ADAPTIVE_PLAN_CONTEXT=0

# Sprint 6 PR6.1 — Adaptive Weekly Program UI rollout gate. PRESENTATION ONLY: it
# decides whether /training renders the weekly-program mount shell + its init script.
# 0 or absent = no shell, no script, no request, no layout change. Independent of
# AI_ADAPTIVE_PLAN_CONTEXT above. Setting it back to 0 is the full rollback.
# The weekly-program API stays authenticated in every flag state.
# Sprint 6 PR6.3 hardened the endpoint independently of this flag: its responses
# carry `Cache-Control: private, no-store` and emit a non-sensitive
# `[TRAINING][WEEKLY_PROGRAM] request_id=... state=...` log line. Neither depends
# on WEEKLY_PROGRAM_UI_ENABLED; flipping this flag changes only the /training UI.
# WEEKLY_PROGRAM_UI_ENABLED=0

# ── AxisAI UIUX Sprint 1 PR1: primary-navigation shell v2 (uiux_sprint1_navigation_v2) ──
# Default OFF preserves the legacy 5-tab shell exactly (Home/Nutrition/Training/
# Progress/Profile). ON renders the four-destination information architecture
# (Today/Plan/Coach/Progress) and moves Nutrition + Community + utility into the
# secondary drawer tier. PRESENTATION ONLY — never an authorization boundary
# (every route keeps its own @require_auth). Widest UI blast radius of the eight
# rollout flags. Rollback: set UIUX_NAV_V2_ENABLED=0 and restart.
# UIUX_NAV_V2_ENABLED=0

# ── AxisAI UIUX Sprint 1 PR2: Today experience v2 (uiux_sprint1_today_v2) ──
# Default OFF renders the legacy Today dashboard (templates/index.html)
# byte-identically. ON renders the PR2 Today hierarchy (templates/today.html):
# one authoritative next action + honest missing/completed/error semantics.
# PRESENTATION ONLY — never an authorization boundary (every route keeps its own
# @require_auth). Server-config only: not settable via query/cookie/header/storage.
# Independent of UIUX_NAV_V2_ENABLED (either flag rolls back alone). Rollback:
# set UIUX_TODAY_V2_ENABLED=0 and restart → the legacy Today dashboard returns.
# UIUX_TODAY_V2_ENABLED=0

# ── AxisAI UIUX Sprint 1 PR3: Plan experience v2 (uiux_sprint1_plan_v2) ──
# Default OFF renders the legacy /training page (templates/training.html +
# static/training.js) byte-identically. ON renders the server-authoritative Plan
# v2 surface (templates/plan.html): the active plan read only from canonical data —
# no clock-based "today" selection, no rest-day inference, no completion from
# localStorage. PRESENTATION ONLY — never an authorization boundary (every route
# keeps its own @require_auth). Server-config only: not settable via query/cookie/
# header/storage. Independent of WEEKLY_PROGRAM_UI_ENABLED and the other UIUX flags
# (each rolls back alone). Rollback: set UIUX_PLAN_V2_ENABLED=0 and restart → the
# legacy /training page returns.
# UIUX_PLAN_V2_ENABLED=0

# ── AxisAI UIUX Sprint 1 PR3: Coach page v2 (uiux_sprint1_coach_page_v2) ──
# Default OFF renders the legacy thin /coach host (templates/coach.html). ON renders
# the hardened Coach destination (templates/coach_v2.html) which REUSES the existing
# widget and guarantees exactly one interactive Coach instance. Changes no AI prompt/
# model/streaming/persistence/rate-limit/moderation policy. PRESENTATION ONLY —
# @require_auth preserved on both paths. Server-config only: not settable via query/
# cookie/header/storage. Independent of every other flag. Rollback: set
# UIUX_COACH_PAGE_V2_ENABLED=0 and restart → the legacy /coach host returns.
# UIUX_COACH_PAGE_V2_ENABLED=0

# ── Sprint 7 PR3: persisted workout-session lifecycle ──
# Default OFF preserves the PR1/PR2 contract EXACTLY: /workout/session/* write
# routes are unavailable (404) and the state resolver emits contract_version=1
# (no resume/in_progress). ON enables session creation and the ADDITIVE
# contract_version=2. Requires migration a994f9bed783 (partial unique index
# uq_workout_session_active_owner = the at-most-one-ACTIVE-session invariant).
# Turning it back off is safe with sessions already persisted: the read contract
# ignores those rows, it never deletes them. Rollback: set
# FITX_WORKOUT_SESSIONS_ENABLED=0 and restart. docs/WORKOUT_STATE.md
# FITX_WORKOUT_SESSIONS_ENABLED=0

# ── AI koç kalıcı konuşma hafızası (Sprint 4 WS1) ──
# Varsayılanlar makul; ilk deploy için .env değişikliği GEREKMEZ.
# AI_MEMORY_ENABLED=1            # 0 → eski davranış (DB'ye tur yazılmaz)
# AI_CONTEXT_TOKEN_BUDGET=3000   # bağlam penceresi (özet+mesajlar) token bütçesi
# AI_SUMMARY_TRIGGER_TOKENS=6000 # özetlenmemiş kuyruk bu boyutu aşınca özetle

# ── AI önbellek / kurtarma / kötüye-kullanım (Sprint 4 WS5/WS9/WS7) ──
# Hepsinin makul varsayılanı var; ilk deploy .env değişikliği GEREKTİRMEZ.
# Redis yoksa önbellek + soğuma sessizce no-op olur (yalnızca retry+lastgood
# Redis'siz de kısmen çalışır: retry evet, lastgood/soğuma hayır).
# WS5 — AI sonuç önbelleği (ai_cache.py). Redis 200mb allkeys-lru → tahliye edilebilir.
# AI_CACHE_ENABLED=1
# AI_CACHE_TTL_FOOD=604800       # besin adı→EN çevirisi (kararlı → 7 gün)
# AI_CACHE_TTL_MACRO=86400       # makro tahmini (1 gün)
# AI_CACHE_TTL_PROMPT=3600       # benzer-prompt (1 saat)
# AI_CACHE_TTL_RECS=21600        # statik öneriler (6 saat)
# WS9 — hata kurtarma (ai_recovery.py): geçici hata → retry → last-good → dostça hata.
# AI_RECOVERY_ENABLED=1
# AI_RETRY_ATTEMPTS=2            # kendi katmanımızdaki toplam deneme (ilk dahil)
# AI_RETRY_BASE_DELAY=0.5        # üstel geri çekilme tabanı (sn)
# AI_RETRY_MAX_DELAY=4.0         # geri çekilme tavanı (sn)
# AI_LASTGOOD_TTL_SECONDS=86400  # son-iyi yanıt saklama süresi
# BEDROCK_MAX_RETRIES=1          # SDK retry'ı; kurtarma katmanı ekstra retry yapar (çarpımı önle)
# WS7 — kötüye-kullanım kısıtları
# AI_BURST_RATELIMIT=5 per minute   # /ask* kısa-pencere burst tavanı (AI_RATELIMIT üstüne)
# AI_FAILURE_THRESHOLD=3            # ardışık AI arızası: bu sayıda soğuma tetiklenir
# AI_FAILURE_COOLDOWN_SECONDS=60    # soğuma süresi (429+Retry-After)

# ── Arka-plan işler + gözlemlenebilirlik (Sprint 4 WS8/WS6) ──
# Worker OPSİYONEL: yoksa işler satır-içine düşer (app çalışmaya devam eder).
# Compose 'worker' servisi REDIS_URL'e ihtiyaç duyar (prod'da zaten var).
# WORKER_MEM_LIMIT=512m          # worker konteyneri bellek tavanı
# WORKER_HEARTBEAT_TTL=120       # /health?deep=1 worker canlılık penceresi (sn)
# /health?deep=1 details are available to loopback and these comma-separated CIDRs.
# Default keeps the Docker bridge gateway only; do not use an entire RFC1918 range.
# DEEP_HEALTH_TRUSTED_CIDRS=172.17.0.1/32
# RQ_SIMPLE_WORKER=0             # 1 → fork'suz SimpleWorker (Windows/dev; win32'de otomatik)
# WS6 — CloudWatch metrikleri (ai_metrics.py). VARSAYILAN KAPALI: EC2 instance
# role'üne cloudwatch:PutMetricData izni verildikten SONRA açın.
# AI_METRICS_ENABLED=0
# AI_METRICS_NAMESPACE=FitX/AI
# Production Hardening PR1 — runtime SLI'ları (runtime_metrics.py). AI_METRICS_
# ENABLED'in KARDEŞİ ve ondan BAĞIMSIZ (ayrı namespace, tek başına geri alınır).
# Aynı IAM izni gerekir. Kayıt istek yolunda tampona yazılır; CloudWatch'a yalnızca
# flush thread'i çıkar → istek gecikmesine round-trip EKLENMEZ. Geri alma:
# RUNTIME_METRICS_ENABLED=0 + web servisini yeniden başlat. docs/OBSERVABILITY.md
# RUNTIME_METRICS_ENABLED=0
# RUNTIME_METRICS_NAMESPACE=FitX/Runtime
# RUNTIME_METRICS_FLUSH_SECONDS=60

# -- Amazon Cognito (native backend API register/verify) --
# Hosted UI, Authlib OAuth, and browser redirects to Cognito are disabled.
# Flask calls Cognito with boto3 through app/services/cognito_service.py.
COGNITO_USER_POOL_ID=eu-central-1_kaX0SORRK
COGNITO_APP_CLIENT_ID=3rdtrk3vl1dp0m1d19gdc3pqib
# App client secret, only if the configured app client has one. Leave blank for public clients.
# Do not commit real secrets.
COGNITO_CLIENT_SECRET=
# Bilinmeyen bir `kid` için ZORUNLU JWKS tazelemesinin soğuma penceresi
# (Hardening PR4). Tazeleme 5 sn'lik bloklayıcı bir ağ çağrısıdır ve hiçbir
# eşzamanlılık kapısının arkasında değildir; koşulsuz olsaydı uydurma kid taşıyan
# istek seli her istek başına bir web thread'ini park ettirebilirdi. 0 = eski
# koşulsuz davranış (ÖNERİLMEZ). docs/CAPACITY.md
# JWKS_FORCED_REFRESH_COOLDOWN_SECONDS=60
# Cognito app client requirements for the native flow:
#   Auth flows: ALLOW_USER_PASSWORD_AUTH enabled
#   User pool attributes: name supplied by sign_up; email verification enabled
# Sprint 2: server-side Cognito token encryption key (Fernet). REQUIRED in prod
# when Cognito is enabled (boot fails without it, S2); dev/test may leave it
# unset (derived from SECRET_KEY). Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# COGNITO_TOKEN_ENC_KEY=
# COGNITO_REFRESH_SKEW_SECONDS=60   # refresh access token this many seconds before exp
# COGNITO_SESSION_IDLE_HOURS=24     # invalidate after this much inactivity
# COGNITO_SESSION_ABSOLUTE_DAYS=7   # force reauthentication after this lifetime

# -- Opaque mobile authentication --
# AxisAI access/refresh credentials remain opaque to Cognito and are stored only
# as SHA-256 hashes. The independent derivation keyring reproduces only committed
# grace-retry responses; never reuse COGNITO_TOKEN_ENC_KEY here.
# Default OFF: the /api/v1 mobile blueprint, keyring parsing, and mobile database
# readiness preflight are omitted. Existing web authentication is unchanged.
# MOBILE_AUTH_ENABLED=0
# MOBILE_AUTH_ACCESS_TTL_SECONDS=900
# MOBILE_AUTH_REFRESH_ABSOLUTE_DAYS=7
# MOBILE_AUTH_REFRESH_RETRY_GRACE_SECONDS=10
# MOBILE_AUTH_COGNITO_EXPIRY_LEEWAY_SECONDS=60
# MOBILE_AUTH_DERIVATION_KEY_RETENTION_BUFFER_SECONDS=300
# MOBILE_AUTH_REFRESH_RATELIMIT=30 per minute; 300 per hour
# MOBILE_AUTH_LOGOUT_RATELIMIT=30 per minute
# Deploy a new key version alongside retained versions before changing active v1.
# Keep referenced versions through their final retry grace plus retention buffer.
# MOBILE_AUTH_ACTIVE_DERIVATION_KEY_VERSION=v1
# MOBILE_AUTH_DERIVATION_KEYRING={...}
# Staged production rollout:
# 1. Merge/deploy with MOBILE_AUTH_ENABLED=0.
# 2. Apply the additive mobile-auth migration.
# 3. Provision the independent keyring and active version (no default key exists).
# 4. Verify derivation-key/database readiness.
# 5. Set MOBILE_AUTH_ENABLED=1 only in a controlled deployment.


# ── E-posta (Resend) — merkezi e-posta altyapısı ──
# Tüm uygulama e-postaları app/services/email_service.py üzerinden gönderilir.
# Gönderim domaini Resend'de doğrulanmıştır: mail.axisaiapp.com
# RESEND_API_KEY yoksa servis KAPALIDIR (gönderimler no-op, lokal/test güvenli).
# NOT: Cognito'nun KOD e-postaları (doğrulama/sıfırlama) buradan DEĞİL,
# infra/cognito-email-sender Lambda'sından gider (kendi RESEND_API_KEY'ini
# SAM parametresiyle alır) — bkz. docs/auth-emails.md.
RESEND_API_KEY=
EMAIL_FROM_NAME=AxisAI
EMAIL_FROM_ADDRESS=noreply@mail.axisaiapp.com
EMAIL_REPLY_TO=hello@axisaiapp.com
# E-postalardaki CTA bağlantılarının tabanı (varsayılan: canlı site).
# APP_BASE_URL=https://www.axisaiapp.com

# ── Wearables (WHOOP v2 + Google Health) ──
# Token şifreleme anahtarı. Üret: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Prod'da zorunlu; lokal/test ortamında SECRET_KEY'den türetilen fallback kullanılır.
WEARABLE_TOKEN_KEY=

WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
WHOOP_REDIRECT_URI=http://localhost:5000/api/auth/callback/whoop

GOOGLE_HEALTH_CLIENT_ID=
GOOGLE_HEALTH_CLIENT_SECRET=
GOOGLE_HEALTH_REDIRECT_URI=http://localhost:5000/api/auth/callback/google_health

# ── AWS S3 (kullanıcı görselleri) ──
# Kimlik bilgileri EC2 IAM Instance Profile'dan OTOMATİK gelir; AWS_ACCESS_KEY_ID /
# AWS_SECRET_ACCESS_KEY burada TUTULMAZ ve koda da yazılmaz.
AWS_REGION=eu-central-1
# "Block all public access" açık (özel) bir bucket olmalı; görseller pre-signed
# URL ile sunulur.
S3_BUCKET_NAME=your-configured-bucket-name

# ── Redis (liderlik tablosu / Club sorted-set önbelleği) ──
# Compose içindeki redis servisine bağlanır. Host "redis" = compose servis adı.
# Postgres kaynak (source of truth) kalır; Redis yalnızca hızlı sıralama katmanıdır.
REDIS_PASSWORD=replace-with-a-long-random-secret
REDIS_URL=redis://:URL_ENCODED_PASSWORD@redis:6379/0

# ── Hata izleme (Sentry) — opsiyonel ──
# DSN ayarlıysa Flask hataları Sentry'ye gider; YOKSA tamamen kapalı (no-op).
# PII gönderilmez (send_default_pii=False). Performans izi varsayılan kapalı.
# SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0
