# FitX ortam değişkenleri örneği.
# Kopyala:  cp .env.example .env   ve değerleri doldur. .env'i COMMIT ETME.

# ── Flask ──
# Uzun, rastgele bir değer üret:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
# Yalnızca yerel geliştirme için (prod'da KAPALI bırak):
# FLASK_DEBUG=1

# ── Veritabanı (Docker Compose Postgres) ──
# Bu üçlü hem db servisini oluşturur hem de DATABASE_URL'de kullanılır.
POSTGRES_USER=fitx
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=fitx
# Host "db" = compose servis adı. (Compose web servisinde bunu zaten override
# eder; yerel/Docker dışı çalıştırma için burada da tutuyoruz.)
DATABASE_URL=postgresql://fitx:change-me-strong-password@db:5432/fitx

# ── FatSecret proxy ──
FATSECRET_CLIENT_ID=
FATSECRET_CLIENT_SECRET=
# Prod'da https zorunlu (OAuth token Authorization başlığında gider).
# nginx /fatsecret/ konumu bunu statik IP'deki proxy'ye yönlendirir.
FATSECRET_BASE_URL=https://your-domain.example.com/fatsecret

# ── AWS Bedrock ──
# DİKKAT: Access key YOK. EC2'ye atanan IAM Instance Profile credential sağlar;
# boto3 varsayılan zincir üzerinden instance role'ü otomatik kullanır.
# (Yerel geliştirmede istersen AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY ekleyebilirsin.)
AWS_REGION=us-east-1
