# AxisAI — STAGING environment template (names only, never values).
#
# Copy onto the staging host as /opt/axisai-staging/repo/.env, fill in values
# generated ON THAT HOST, then `chmod 600 .env`. Do NOT commit the filled file.
#
# ── READ THIS FIRST: staging is not "production with a different name" ───────
# This template exists so a staging host can be rebuilt WITHOUT anyone reaching
# for the production .env. Copying a production value into this file destroys
# the isolation the whole environment is built on:
#
#   * a production DATABASE_URL here means staging writes to real user data;
#   * a production COGNITO_USER_POOL_ID here means staging emails real people
#     and staging test accounts appear in the production user pool;
#   * a production SECRET_KEY or COGNITO_TOKEN_ENC_KEY here means a staging
#     session cookie is valid in production.
#
# Every secret below is generated FRESH on the staging host. None is shared
# with production, and none needs to be: staging has no real data to protect
# and no real user to notify. See docs/STAGING.md.

# ── Flask ──
# Generate on the host: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# NOT the production SECRET_KEY. A shared value would make staging session
# cookies forgeable into production ones.
SECRET_KEY=

# FLASK_DEBUG / FLASK_ENV are deliberately ABSENT.
# app/config.py derives FITX_IS_DEV from them, and FITX_IS_DEV=1 would turn off
# SESSION_COOKIE_SECURE and make DATABASE_URL optional (silent SQLite fallback).
# Staging must exercise the production code paths, so it runs as non-dev.

# ── Staging database (container-local PostgreSQL, NOT RDS) ──
# docker-compose.staging.yml adds a `db` service that production does not have.
# It is reachable only on the compose network — no host port, no public port.
#
# Generate the password on the host; it never leaves the instance. Keep it to
# [A-Za-z0-9] — this value is read twice, and both readers have opinions:
#   * Compose parses this file, so `#` starts a comment and `$` triggers
#     variable interpolation of ${STAGING_DB_PASSWORD} in the overlay;
#   * DATABASE_URL below is a URL, so `@ : / ?` would be parsed as delimiters
#     and would need percent-encoding there but not here.
# An alphanumeric password sidesteps both. Generate one with:
#   python3 -c "import secrets,string; print(''.join(secrets.choice(string.ascii_letters+string.digits) for _ in range(40)))"
STAGING_DB_USER=
STAGING_DB_PASSWORD=
STAGING_DB_NAME=
# MUST point at the compose service `db`, and MUST appear exactly once. Write
# the three values above out in full here — this line is a second copy of them,
# not an interpolation, and a mismatch fails at boot with an auth error.
#
# scripts/staging_deploy.sh refuses to deploy if it finds anything other than
# one DATABASE_URL line, or if the value contains rds.amazonaws.com. Both
# refusals matter: Compose's env_file takes the LAST assignment of a key, so
# appending a corrected line instead of editing this one in place would leave
# the app using a value the guard never inspected.
DATABASE_URL=postgresql://STAGING_DB_USER:STAGING_DB_PASSWORD@db:5432/STAGING_DB_NAME

# ── Redis ──
REDIS_PASSWORD=
REDIS_URL=redis://:URL_ENCODED_PASSWORD@redis:6379/0

# ── Cognito (SEPARATE staging user pool) ──
# The staging pool is created with NO CustomEmailSender Lambda, so staging can
# never send mail to a real person even if someone registers a real address.
# Staging accounts are created by an operator with --message-action SUPPRESS.
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=
# Blank for a public app client (the staging client is public).
COGNITO_CLIENT_SECRET=
# Fernet key, generated on the host:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Required outside dev when Cognito is enabled. NOT the production key.
COGNITO_TOKEN_ENC_KEY=

# ── Wearables ──
# Required outside dev. Fernet key, generated on the host, staging-only.
WEARABLE_TOKEN_KEY=

# ── Opaque mobile authentication (needed for the native transport) ──
MOBILE_AUTH_ENABLED=1
MOBILE_AUTH_ACTIVE_DERIVATION_KEY_VERSION=v1
# JSON object {"v1": "<base64url, >=32 bytes, unpadded>"}. Generate on the host:
#   python3 -c "import base64,json,secrets; print(json.dumps({'v1': base64.urlsafe_b64encode(secrets.token_bytes(32)).decode().rstrip('=')}))"
# Never reuse COGNITO_TOKEN_ENC_KEY here, and never reuse the production keyring.
MOBILE_AUTH_DERIVATION_KEYRING=

# ── Feature flags ──
# The staging environment ships with the Sprint 14 flag OFF. Establishing the
# environment and activating the feature are separate, separately reviewed acts;
# the infrastructure slice must not decide the activation. PR5 flips this on the
# staging host as part of its own exercise — not here, and never in this file.
FITX_WORKOUT_SESSIONS_ENABLED=0

# ── Observability ──
# Staging metrics go to their OWN namespaces. The staging instance role is
# scoped to these two and is DENIED FitX/Runtime and FitX/AI, so a
# mis-set namespace here cannot contaminate a production metric — it fails
# with AccessDenied instead.
RUNTIME_METRICS_ENABLED=1
RUNTIME_METRICS_NAMESPACE=AxisAI/Staging/Runtime
AI_METRICS_ENABLED=0
AI_METRICS_NAMESPACE=AxisAI/Staging/AI

# ── AWS / external services: deliberately unconfigured ──
# Staging holds no real user data and must not be able to create any outside
# itself. Leaving these blank keeps the app on its documented degraded paths
# (s3_helper disabled, email no-op, Bedrock/OpenAI unconfigured) rather than
# borrowing production credentials to look "complete".
AWS_REGION=eu-central-1
# Blank = s3_helper.is_enabled() is False. Do NOT point this at the production
# bucket; staging photo writes would land in real users' storage.
S3_BUCKET_NAME=
# Blank = email service is a no-op. A real key here could mail real people.
RESEND_API_KEY=
BEDROCK_ENABLED=0
OPENAI_API_KEY=
FATSECRET_CLIENT_ID=
FATSECRET_CLIENT_SECRET=
FATSECRET_BASE_URL=
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
GOOGLE_HEALTH_CLIENT_ID=
GOOGLE_HEALTH_CLIENT_SECRET=
SENTRY_DSN=

# Staging is reached over an SSM port-forward to http://localhost:5000; there is
# no staging DNS name and no public ingress. See docs/STAGING.md.
APP_BASE_URL=http://localhost:5000
