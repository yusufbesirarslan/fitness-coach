{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axisai.local/schemas/findings-1.0.0.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "extraction_rules_version", "findings"],
  "properties": {
    "schema_version": {"const": "1.0.0"}, "extraction_rules_version": {"const": "1.0.0"},
    "findings": {"type": "array", "items": {
      "type": "object", "additionalProperties": true,
      "required": ["id", "claim", "source_refs", "status"],
      "properties": {
        "id": {"type": "string", "pattern": "^EXT-[0-9]{3}$"},
        "claim": {"type": "string", "minLength": 1},
        "source_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "status": {"enum": ["CONFIRMED_BUG", "CONFIRMED_UX_ISSUE", "CONFIRMED_ARCHITECTURE_ISSUE", "PRODUCT_DECISION_REQUIRED", "PARTIALLY_CONFIRMED", "NOT_REPRODUCIBLE", "ALREADY_RESOLVED", "OUTDATED_EVIDENCE", "OUT_OF_BETA_SCOPE", "BLOCKED_BY_MISSING_ENVIRONMENT"]}
      }
    }}
  }
}
